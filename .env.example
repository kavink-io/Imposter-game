# ====================================================================
# Imposter Party 🎭 - Environment Variables Example
# ====================================================================

# Your Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon Public Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: NEVER put your SUPABASE_SERVICE_ROLE_KEY here.
# The frontend only uses the Anon key. All privileged mutations run via SECURITY DEFINER PostgreSQL functions!
